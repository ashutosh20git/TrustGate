# Copy to .env and fill in. Values in <angle brackets> count as unset (placeholders).
# Anything not set makes its feature fail closed or run degraded; see PLACEHOLDERS.md.

# --- LLMs (via LiteLLM) ------------------------------------------------------
# Set the provider key(s) you use, and pin the model ids (version suffix required;
# the CI model-pin check rejects unpinned names). The agent and the attacker must
# be different models (dossier 13.3).
ANTHROPIC_API_KEY=<your-anthropic-key>
OPENAI_API_KEY=<your-openai-key>
GEMINI_API_KEY=<your-gemini-key>
TRUSTGATE_AGENT_MODEL=<e.g. anthropic/claude-opus-4-8>
TRUSTGATE_ATTACKER_MODEL=<a different model, e.g. openai/gpt-4.1-2025-04-14>
# Temperature is sent only if set. Current Claude models reject sampling params:
# leave this unset and pin determinism with the model version instead.
# TRUSTGATE_AGENT_TEMPERATURE=0

# --- Facts-only re-check -----------------------------------------------------
# xgboost: the starter model baked into the Docker image (trained on synthetic
# alerts; retrain on your own with scripts/train_recheck.py). ollama: a local LLM.
TRUSTGATE_RECHECK_BACKEND=xgboost         # xgboost | ollama
TRUSTGATE_XGB_MODEL=models/recheck_xgb.json
# The classifier's "benign" counts only at this probability or above; below it, unsure (escalate).
TRUSTGATE_RECHECK_MIN_CONFIDENCE=0.9
# Second judge: the rule scorecard runs beside the model and benign needs both (off to disable).
TRUSTGATE_RECHECK_SCORECARD=on
OLLAMA_HOST=http://host.docker.internal:11434
TRUSTGATE_RECHECK_MODEL=<e.g. qwen2.5:3b>  # pull it first: `ollama pull qwen2.5:3b`

# --- Detector (IOC signals, bonus only) --------------------------------------
# Prompt Guard 2 is a gated HF model: request access, then set HF_TOKEN.
HF_TOKEN=<your-hf-token>
# TRUSTGATE_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
# DETECTOR_URL=http://detector:8082        # set by docker-compose for the ingest service

# --- Threat intel (ingest only; responses cached) ----------------------------
VIRUSTOTAL_API_KEY=<key>
ABUSEIPDB_API_KEY=<key>
OTX_API_KEY=<key>
URLHAUS_AUTH_KEY=<key>
# Sources that must independently call a link clean (2 = VirusTotal and URLhaus must agree).
TRUSTGATE_TI_QUORUM=1

# --- Email auth (required for trusted SPF/DKIM/DMARC facts) -------------------
# Your MTA's Authentication-Results authserv-id. Without it, auth facts are unknown
# unless the SIEM supplies the envelope for live verification. Microsoft 365 / Exchange
# Online writes no authserv-id: use TRUSTGATE_MTA_AUTHSERV_ID=microsoft365.
TRUSTGATE_MTA_AUTHSERV_ID=mx.corp.example

# --- Gate --------------------------------------------------------------------
TRUSTGATE_MODE=enforce                    # enforce | monitor
TRUSTGATE_POLICY=packs/soc.rego
TRUSTGATE_CHECK_TIMEOUT_S=10
TRUSTGATE_MAX_INFLIGHT_CHECKS=16          # saturated gate fails closed at once
TRUSTGATE_ESCALATION_TTL_S=14400          # analyst approvals older than this are refused
# OPA_URL is set by docker-compose; for host runs point OPA_BIN at the binary:
# OPA_BIN=.tools/opa.exe

# --- Storage, rate limits, SIEM export ---------------------------------------
DATABASE_URL=sqlite:///./trustgate.db
REDIS_URL=redis://localhost:6379/0
TRUSTGATE_RATELIMIT_BACKEND=redis         # redis | memory
# TRUSTGATE_SIEM_JSONL=audit.jsonl
# SPLUNK_HEC_URL=https://splunk.example:8088/services/collector
# SPLUNK_HEC_TOKEN=<token>

# --- Self-hosting (docker compose) -------------------------------------------
# Required: the Postgres password. Generate one: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=<set-a-long-random-password>
# Published ports (proxy 8080, ingest 8081, dashboard 8501) bind here. Keep 127.0.0.1
# and put a TLS reverse proxy in front; 0.0.0.0 exposes them on every interface.
TRUSTGATE_BIND_ADDR=127.0.0.1
# TRUSTGATE_IMAGE=ghcr.io/ashutosh20git/trustgate:2.4   # default :latest; or your registry's copy
# TRUSTGATE_EXTRAS=standard               # full = add Prompt Guard 2 / LLM Guard (torch, several GB)

# --- Service tokens (scripts/init_secrets.py writes these to secrets/) --------
# Docker reads them from secrets/; set them here only for runs outside Docker.
# TRUSTGATE_INGEST_TOKEN=<from secrets/ingest_token.txt>     # the SIEM sends it to ingest
# TRUSTGATE_ANALYST_TOKENS=<name:sha256 lines>               # proxy only
# TRUSTGATE_PROVENANCE_KEY=<shared key>                      # optional; same on every TrustGate

# --- Tool credentials (proxy + mock-soc only) --------------------------------
MOCK_SOC_TOKEN=<run scripts/init_secrets.py>
MOCK_SOC_URL=http://localhost:8090

# --- Optional baselines ------------------------------------------------------
# LAKERA_API_KEY=<key>
