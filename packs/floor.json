{
  "floor": {
    "description": "Shared floor: rules and entity blocks no per-app pack can loosen.",
    "block_entities": [
      "CREDIT_CARD",
      "CRYPTO",
      "IBAN_CODE",
      "US_SSN",
      "IN_AADHAAR",
      "IN_PAN",
      "API_KEY",
      "PRIVATE_KEY",
      "PASSWORD"
    ],
    "min_rate_limits": {
      "0": 600,
      "1": 60,
      "2": 20,
      "3": 20
    },
    "t1_evidence": {
      "description": "Deterministic minimum evidence for any T1 (security-reducing) action, whatever the re-check model says. core_facts must be known; when a source lists costly_support, at least one of those conditions must hold (facts an attacker cannot buy cheaply for a fresh campaign). At least one cited typed fact must meet a benign_support condition. Sender and organisation history (org_replied_to_sender: an attacker cannot make staff reply) stop counting as costly support when any costly_negated_by fact is true (a known sender behaving unusually: how a compromised account looks).",
      "core_facts": {
        "email": [
          "dmarc_pass"
        ],
        "network": [
          "ip_abuse_score"
        ],
        "endpoint": [
          "sandbox_verdict"
        ],
        "auth": [
          "ip_abuse_score"
        ]
      },
      "costly_support": {
        "email": [
          {
            "fact": "sender_prior_messages",
            "op": ">=",
            "value": 3
          },
          {
            "fact": "org_replied_to_sender",
            "op": "==",
            "value": true
          }
        ]
      },
      "benign_support": [
        {
          "fact": "spf_pass",
          "op": "==",
          "value": true
        },
        {
          "fact": "dkim_pass",
          "op": "==",
          "value": true
        },
        {
          "fact": "dmarc_pass",
          "op": "==",
          "value": true
        },
        {
          "fact": "url_reputation",
          "op": "==",
          "value": "clean"
        },
        {
          "fact": "sandbox_verdict",
          "op": "==",
          "value": "clean"
        },
        {
          "fact": "ip_abuse_score",
          "op": "<",
          "value": 25
        },
        {
          "fact": "sender_prior_messages",
          "op": ">=",
          "value": 1
        },
        {
          "fact": "sender_domain_age_days",
          "op": ">=",
          "value": 30
        },
        {
          "fact": "org_replied_to_sender",
          "op": "==",
          "value": true
        },
        {
          "fact": "arc_pass",
          "op": "==",
          "value": true
        },
        {
          "fact": "bimi_pass",
          "op": "==",
          "value": true
        },
        {
          "fact": "process_signed",
          "op": "==",
          "value": true
        }
      ],
      "costly_negated_by": [
        "reply_to_mismatch",
        "sender_first_link",
        "sender_first_attachment",
        "sender_new_sending_ip",
        "org_url_domain_first_seen"
      ]
    },
    "sequence": {
      "description": "Actions already executed on the same alert (not reverted) inside window_s. One security-reducing action per alert runs automatically; a chain such as whitelist then close then suppress needs a human.",
      "window_s": 86400,
      "max_t1_per_alert": 1
    }
  }
}
