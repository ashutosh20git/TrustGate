{
  "packs": {
    "generic": {
      "description": "Generic pack for any tool-using agent; shipped tool map fits the demo email assistant. Placeholder allowlist values.",
      "tools": {
        "read_inbox": 0,
        "summarise_message": 0,
        "draft_reply": 0,
        "mark_as_read": 0,
        "add_safe_sender": 1,
        "create_forwarding_rule": 1,
        "mark_not_phishing": 1,
        "delete_message": 2,
        "block_sender": 2,
        "send_email": 3,
        "forward_email": 3
      },
      "targets": {
        "block_sender": {
          "arg": "sender",
          "fact": "accounts"
        },
        "delete_message": {
          "arg": "message_id",
          "fact": null
        }
      },
      "outbound": {
        "send_email": {
          "recipient_arg": "to",
          "body_args": [
            "subject",
            "body"
          ]
        },
        "forward_email": {
          "recipient_arg": "to",
          "body_args": [
            "note"
          ]
        }
      },
      "critical_assets": [],
      "allowlist": [
        "me@corp.example",
        "team@corp.example"
      ],
      "output_scan": {
        "allow_entities": [
          "DATE_TIME",
          "URL"
        ],
        "redact_entities": [
          "PHONE_NUMBER",
          "PERSON",
          "LOCATION",
          "IP_ADDRESS"
        ],
        "block_entities": []
      },
      "rate_limits": {
        "0": 120,
        "1": 20,
        "2": 10,
        "3": 10
      },
      "detector": {
        "sender_allowlist": []
      },
      "agent_text": {
        "draft_reply": [
          "body"
        ],
        "summarise_message": [
          "summary"
        ]
      },
      "summary_tools": [],
      "expiring_tools": {
        "add_safe_sender": {
          "ttl_arg": "ttl_hours",
          "max_hours": 24
        },
        "create_forwarding_rule": {
          "ttl_arg": "ttl_hours",
          "max_hours": 24
        }
      },
      "campaign_rate_limits": {
        "window_s": 3600,
        "1": 10,
        "shared_domains": [
          "gmail.com",
          "googlemail.com",
          "outlook.com",
          "hotmail.com",
          "live.com",
          "yahoo.com",
          "icloud.com",
          "proton.me",
          "protonmail.com"
        ]
      }
    }
  }
}
